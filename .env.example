# UpDownVid Environment Configuration
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# Server Configuration
HOST=0.0.0.0
PORT=3000
DEBUG=True
IS_PRODUCTION=False

# Session & Security (REQUIRED - generate random strings)
SESSION_SECRET=change-this-to-random-secret-key

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Application URLs
FRONTEND_URL=http://localhost:5000
BACKEND_URL=http://localhost:3000

# Google OAuth Configuration (REQUIRED for YouTube upload)
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google_login/callback

# YouTube API
YOUTUBE_API_KEY=your_youtube_api_key_here

# Supabase Configuration (Backend - service role for server-side operations)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Supabase Configuration (Frontend - anon key only, safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Download Configuration
MAX_FILE_SIZE_MB=4096
MAX_UPLOAD_SIZE=20971520
AUTO_CLEANUP_AGE=3600

# SSE Configuration
SSE_HEARTBEAT_INTERVAL=15
SSE_POLL_INTERVAL=0.5

# Frontend Backend URL (for direct EventSource/SSE connections)
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000
